# Postgres — deltax_writer role on database `alex`
# See sql/00_create_deltax_writer.sql
#DELTAX_DATABASE_URL=postgresql://deltax_writer:PASSWORD@HOST:5432/alex?sslmode=prefer
# Or decomposed:
# DELTAX_DB_HOST=HOST
# DELTAX_DB_PORT=5432
# DELTAX_DB_NAME=alex
# DELTAX_DB_USER=deltax_writer
# DELTAX_DB_PASSWORD=
# DELTAX_DB_SSLMODE=prefer

# Telegram groups (sharpener-style): GROUP:TOKEN:CHAT_ID[,GROUP2:TOKEN:CHAT_ID]
# Leave empty to disable Telegram (alerts still persist to DB).
# DELTAX_TELEGRAM_GROUPS=A:123456789:AAH...:-5162071249

# Which groups receive drop alerts (subset of DELTAX_TELEGRAM_GROUPS)
# DELTAX_ALERT_GROUPS=A

# Optional overrides
# DELTAX_CONFIG_PATH=config.tipsport.yaml   # Tipsport monitor / settler
# DELTAX_CONFIG_PATH=config.pinnacle.yaml   # Pinnacle monitor
# DELTAX_SOURCE=tipsport
# DELTAX_REFRESH_SECONDS=30
# DELTAX_MAX_ODDS=5.0
# DELTAX_LOG_LEVEL=INFO

# Pinnacle monitor (QX-336) — copy config.pinnacle.yaml.example, tune, then restart production
# DELTAX_PINNACLE_ENABLED=1                   # set 0 to skip pinnacle worker in production start

# Settler worker (deltax_settle_tipsport) — use deltax_settler DB role
# DELTAX_SETTLE_DATABASE_URL=postgresql://deltax_settler:PASSWORD@HOST:5432/alex?sslmode=prefer
# Or decomposed:
# DELTAX_SETTLE_DB_HOST=HOST
# DELTAX_SETTLE_DB_PORT=5432
# DELTAX_SETTLE_DB_NAME=alex
# DELTAX_SETTLE_DB_USER=deltax_settler
# DELTAX_SETTLE_DB_PASSWORD=
# DELTAX_SETTLE_DB_SSLMODE=prefer
# DELTAX_SETTLE_SLEEP_SECONDS=900
# DELTAX_SETTLE_DEFAULT_DELAY_HOURS=6
# DELTAX_SETTLE_MAX_AGE_DAYS=3
